{
  "name": "explainer-starter",
  "version": "1.0.0",
  "private": true,
  "description": "Multi-scene explainer starter for AI-agent-driven Remotion videos",
  "scripts": {
    "dev": "remotion studio",
    "render": "remotion render Main out/video.mp4",
    "render:qa": "remotion render Main out/video.mp4 --scale=0.5",
    "qa": "node ../../tools/remotion-qa.mjs out/video.mp4 30",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@remotion/cli": "^4.0.0",
    "@remotion/google-fonts": "^4.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "remotion": "^4.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "typescript": "^5.8.0"
  }
}
